{
  "name": "@tryforge/reforge.canvas",
  "version": "2.0.1",
  "description": "ReForgeCanvas: a hardened ForgeScript canvas extension. Create and edit images with limits on what user text can fetch, read or write. Fork of tryforge/ForgeCanvas.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "docgen": "node dist/docgen",
    "license": "node dist/@build/license.js",
    "test": "node --expose-gc --test --test-reporter=spec \"test/*.test.js\"",
    "lint": "tsc --noEmit && node scripts/lint.js",
    "docs": "tsc && npm run license && typedoc src/index.ts && node dist/docgen",
    "bot": "swc src -d dist --strip-leading-paths && node --env-file=.env dist/__tests__/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Demonic1594/ReForgeCanvas.git"
  },
  "keywords": [
    "forgescript",
    "botforge",
    "forge",
    "canvas",
    "image",
    "png",
    "jpeg",
    "gif",
    "reforge",
    "hardened"
  ],
  "author": "lordex (ForgeCanvas); ReForgeCanvas fork maintainers",
  "license": "LGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/Demonic1594/ReForgeCanvas/issues"
  },
  "homepage": "https://github.com/Demonic1594/ReForgeCanvas#readme",
  "dependencies": {
    "@gifsx/gifsx": "^1.0.15",
    "@napi-rs/canvas": "^1.0.9"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@tryforge/forgescript": "^2.7.1",
    "@types/node": "^22.20.4",
    "ipaddr.js": "^2.5.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@tryforge/forgescript": "^2"
  },
  "trustedDependencies": [
    "@swc/core"
  ],
  "files": [
    "dist/**/*",
    "!dist/__tests__/**",
    "metadata/**/*",
    "assets/**/*",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.17"
  }
}
